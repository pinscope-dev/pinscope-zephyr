source "share/sysbuild/Kconfig"

# On the nRF5340 the application core has no random generator of its own; it
# asks the Bluetooth controller on the network core, which this image runs.
config NET_CORE_BOARD
	string
	default "nrf7002dk/nrf5340/cpunet" if $(BOARD) = "nrf7002dk"
	default "nrf5340dk/nrf5340/cpunet" if $(BOARD) = "nrf5340dk"

config NET_CORE_IMAGE_HCI_IPC
	bool "HCI IPC image on network core"
	default y
	depends on NET_CORE_BOARD != ""
