/* The WiFi stack does not leave room for two images in the 1 MB of internal
 * flash: the application gets all of it, and the update slot goes to the
 * board's external flash (MX25R64). MCUboot uses the same layout. */
/delete-node/ &slot1_partition;

&slot0_partition {
	reg = <0x00010000 0xe8000>;
};

&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot1_partition: partition@0 {
			label = "image-1";
			reg = <0x00000000 0xe8000>;
		};
	};
};
