/* Zephyr's own W55RP20-EVB-Pico board, without MCUboot (no updates): the
 * application starts the flash, settings take its last 64 KB. With MCUboot,
 * build for w55rp20_pinscope instead. */
&code_partition {
	reg = <0x100 (DT_SIZE_M(2) - 0x100 - DT_SIZE_K(64))>;
};

&flash0 {
	partitions {
		storage_partition: partition@1f0000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x001f0000 DT_SIZE_K(64)>;
		};
	};
};

